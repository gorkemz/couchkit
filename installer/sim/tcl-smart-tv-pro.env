# Simulated device for --dry-run: TCL "Smart TV Pro" (P735 series, Google TV, Android 11),
# factory state (stock home screen, nothing from CouchKit installed).
prop.ro.product.manufacturer=TCL
prop.ro.product.brand=TCL
prop.ro.product.model=Smart TV Pro
prop.ro.product.name=G03_4K_GB
prop.ro.product.device=BeyondTV4
prop.ro.build.version.sdk=30
prop.ro.build.version.release=11
prop.ro.product.cpu.abi=armeabi-v7a
prop.ro.software.version_id=V8-R51MT05-LF1V620
feature.leanback=true
role.home=com.google.android.apps.tv.launcherx
resolve.home=com.google.android.apps.tv.launcherx/.home.HomeActivity
secure.enabled_accessibility_services=null
secure.accessibility_enabled=0
secure.screensaver_components=com.google.android.backdrop/com.google.android.backdrop.Backdrop
appop.100=APP_AUTO_START
appop.101=APP_ASSOC_START
pkg.com.google.android.apps.tv.launcherx=enabled
pkg.com.google.android.tungsten.setupwraith=enabled
pkg.com.tcl.bi=enabled
pkg.com.tcl.logkit=enabled
pkg.com.tcl.esticker=enabled
pkg.com.tcl.overseasappshow=enabled
pkg.com.tcl.waterfall.overseas=enabled
pkg.com.tcl.channelplus=enabled
pkg.com.tcl.messagebox=enabled
pkg.com.google.android.feedback=enabled
pkg.com.google.android.play.games=enabled
pkg.com.google.android.apps.tv.dreamx=enabled
